# CloudVuln Frontend Environment Variables

# ── Supabase (Required for Authentication & Google OAuth) ──────────
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Google OAuth via Supabase Configuration ───────────────────────
# 1. In Google Cloud Console: Create OAuth 2.0 Web Client ID
#    - Authorized Redirect URI: https://<your-project-ref>.supabase.co/auth/v1/callback
# 2. In Supabase Dashboard -> Authentication -> Providers -> Google:
#    - Enable Google provider and paste your Client ID & Client Secret
# 3. In Supabase Dashboard -> Authentication -> URL Configuration:
#    - Set Site URL (e.g. http://localhost:3000 or https://yourdomain.com)

# ── Python Backend (Optional) ──────────────────────────────────────
# Set to your deployed Render API backend URL, e.g.:
# VITE_API_URL=https://cloudvuln-api.onrender.com/api
# Leave empty when using Vercel rewrites to proxy /api directly.

